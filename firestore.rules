rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper: Check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Global helper: Check if the user has the 'admin' role
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Users can read/write their own profiles. Admins can manage all users (e.g. staff management).
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{settingId} {
      // Authenticated users (staff/admin) can read company info, invoice prefix, tax, and billing configurations.
      allow read: if isAuthenticated();
      // Only admins can update company details, SMTP API keys, and Stripe credentials.
      allow write: if isAdmin();
    }

    // --- CUSTOMERS COLLECTION ---
    match /customers/{customerId} {
      // Authenticated staff or admin can read/write customer profiles.
      allow read, write: if isAuthenticated();

      // Nested subcollection for customer payment methods
      match /paymentMethods/{methodId} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- INVOICES COLLECTION ---
    match /invoices/{invoiceId} {
      // Authenticated staff or admin can read/write invoices.
      allow read, write: if isAuthenticated();
    }

    // --- PAYMENTS COLLECTION ---
    match /payments/{paymentId} {
      // Authenticated staff or admin can read/write payment history.
      allow read, write: if isAuthenticated();
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      // Authenticated staff or admin can read/write product/service catalog.
      allow read, write: if isAuthenticated();
    }
  }
}
